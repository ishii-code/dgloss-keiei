# ── Supabase 認証（TECH_STACK: Supabase Auth・Google・社内ドメイン制限） ──
# 未設定なら認証オフ（開発モード）で誰でも閲覧可。本番は必ず設定すること。
# Supabase: org dnzmjxsqduwxgoafckxt / リージョン ap-northeast-1（東京）に
# ツール専用プロジェクトを作成し、Authentication で Google プロバイダを有効化。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ログインを許可するメールドメイン（カンマ区切り）。未設定=制限なし。
# 例: ALLOWED_EMAIL_DOMAINS=dgloss.jp,peco-japan.com
ALLOWED_EMAIL_DOMAINS=

# ── 会計/請求データ（④実データ接続・Supabase PostgreSQL） ──
# 未設定なら DB オフ（モック表示）。設定すると財務(売上/コスト/計画)を DB から読む。
# Supabase プロジェクトの接続文字列（Connection Pooling 推奨）。
DATABASE_URL=
